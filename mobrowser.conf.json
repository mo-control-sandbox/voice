{
  "app": {
    "name": "moVoice",
    "version": {
      "major": "1",
      "minor": "0",
      "patch": "0"
    },
    "author": "Vlad Lubenskyi",
    "copyright": "Copyright © 2026 TeamDev",
    "description": "A productivity tool for converting voice to text",
    "bundle": {
      "macOS": {
        "icon": "assets/app.icns",
        "bundleID": "com.teamdev.moVoice",
        "codesignIdentity": "${MACOS_CODESIGN_IDENTITY}",
        "codesignKeychain": "${KEYCHAIN_PATH}",
        "codesignEntitlements": "assets/entitlements.plist",
        "teamID": "${MACOS_TEAM_ID}",
        "appleID": "${MACOS_APPLE_ID}",
        "password": "${MACOS_APP_PASSWORD}",
        "installer": {
          "dmg": {
            "name": "",
            "volumeName": "",
            "volumeIcon": "assets/app.icns",
            "eula": "",
            "window": {
              "textSize": 14,
              "skipPrettifying": false,
              "backgroundImage": "",
              "position": {
                "x": 500,
                "y": 400
              },
              "size": {
                "width": 600,
                "height": 400
              },
              "icon": {
                "size": 150,
                "position": {
                  "x": 160,
                  "y": 160
                }
              },
              "appDropLink": {
                "x": 430,
                "y": 160
              }
            }
          }
        }
      },
      "Windows": {
        "icon": "assets/app.ico",
        "signCommand": "",
        "installer": {
          "exe": {
            "name": "",
            "icon": "assets/app.ico",
            "installationGif": "",
            "deltaStrategy": "BestSpeed"
          }
        }
      },
      "Linux": {
        "icon": "assets/app.png"
      }
    }
  }
}
